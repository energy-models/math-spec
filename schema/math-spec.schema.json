{
  "$defs": {
    "BoundsBlock": {
      "additionalProperties": false,
      "description": "Variable bounds \u2014 each side is a number or parameter name.\n\nAn omitted bound leaves the variable unbounded on that side, not\nimplicitly non-negative.",
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Upper"
        }
      },
      "title": "BoundsBlock",
      "type": "object"
    },
    "ConstraintBlock": {
      "additionalProperties": false,
      "description": "A declared constraint: one rule, over one frame.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "foreach": {
          "items": {
            "type": "string"
          },
          "title": "Foreach",
          "type": "array"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        }
      },
      "required": [
        "foreach",
        "expression"
      ],
      "title": "ConstraintBlock",
      "type": "object"
    },
    "DimensionBlock": {
      "additionalProperties": false,
      "description": "A declared dimension, and the dtype its coordinates must be.\n\nA dimension is an axis and nothing else: it declares that the axis exists\nand what its coordinates are typed as, never which coordinates there are \u2014\nthose are data, and arrive at bind time. The maps its members carry \u2014 a\ngenerator's bus, a snapshot's period \u2014 are top-level ``lookups:``\n(:class:`LookupBlock`), keyed by their own name.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dtype": {
          "default": "str",
          "enum": [
            "float",
            "int",
            "str",
            "datetime"
          ],
          "title": "Dtype",
          "type": "string"
        }
      },
      "title": "DimensionBlock",
      "type": "object"
    },
    "ExpressionBlock": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "A named quantity: one arithmetic expression, readable after a solve.\n\nWritten in YAML as a bare string, or as a mapping once it carries a\n``description:`` \u2014 and serialised back to whichever form it was written in,\nso a round trip through :meth:`Spec.to_yaml` reproduces the file::\n\n    expressions:\n      total_generation: sum(p, over=generator)\n      emissions:\n        expression: sum(p * rate, over=generator)\n        description: CO2 released, the quantity the cap bounds\n\nA quantity whose value varies by region is written as ``cases:`` over a\ndeclared ``foreach:``, with an ``otherwise:`` for the rest \u2014 see the\nlanguage reference.",
          "properties": {
            "cases": {
              "additionalProperties": {
                "$ref": "#/$defs/ExpressionCase"
              },
              "default": {},
              "minProperties": 1,
              "title": "Cases",
              "type": "object"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Description"
            },
            "expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expression"
            },
            "foreach": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Foreach"
            },
            "otherwise": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Otherwise"
            }
          },
          "title": "ExpressionBlock",
          "type": "object"
        },
        {
          "type": "string"
        }
      ]
    },
    "ExpressionCase": {
      "additionalProperties": false,
      "description": "One region of a named expression: the value, and when it is the value.\n\nEvery case says where it applies. The value wherever none of them does is\nthe block's ``otherwise:``, which is written outside ``cases:`` because it\nis not a region like these \u2014 it is what is left::\n\n    cases:\n      opening: { when: \"position(snapshot) == 0\", expression: p_max }\n    otherwise: 0",
      "properties": {
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Expression"
        },
        "when": {
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "when",
        "expression"
      ],
      "title": "ExpressionCase",
      "type": "object"
    },
    "LookupBlock": {
      "additionalProperties": false,
      "description": "A named single-valued map out of a dimension (the declaration rules).\n\nExactly one of ``into:`` (a groupable map onto that dimension, what\n``sum(by=)`` lands terms on) or ``dtype:`` (its own label space, selection\nonly)::\n\n    lookups:\n      bus_of: {over: generator, into: bus}\n      period: {over: snapshot, dtype: int}\n\nThe map itself is data, and arrives at bind time under the lookup's name.",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "enum": [
                "total",
                "masked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dtype": {
          "anyOf": [
            {
              "enum": [
                "float",
                "int",
                "str",
                "datetime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "into": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Into"
        },
        "over": {
          "title": "Over",
          "type": "string"
        }
      },
      "required": [
        "over"
      ],
      "title": "LookupBlock",
      "type": "object"
    },
    "MacroBlock": {
      "additionalProperties": false,
      "description": "A parameterised expression template, defined in the YAML itself.\n\nLanguage, not code: formals (``args`` positional, ``kwargs`` keyword)\nshadow model names inside the template, and every call site expands into\ncore AST before either backend sees the expression.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "kwargs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kwargs",
          "type": "array"
        },
        "template": {
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template"
      ],
      "title": "MacroBlock",
      "type": "object"
    },
    "ObjectiveBlock": {
      "additionalProperties": false,
      "description": "A declared objective function.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "sense": {
          "default": "minimize",
          "enum": [
            "minimize",
            "maximize"
          ],
          "title": "Sense",
          "type": "string"
        }
      },
      "required": [
        "expression"
      ],
      "title": "ObjectiveBlock",
      "type": "object"
    },
    "ParameterBlock": {
      "additionalProperties": false,
      "description": "A declared parameter with dims and dtype.",
      "properties": {
        "coverage": {
          "default": "total",
          "enum": [
            "total",
            "masked"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dims": {
          "items": {
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "default": "float",
          "enum": [
            "float",
            "int",
            "bool",
            "str"
          ],
          "title": "Dtype",
          "type": "string"
        }
      },
      "required": [
        "dims"
      ],
      "title": "ParameterBlock",
      "type": "object"
    },
    "PiecewiseBlock": {
      "additionalProperties": false,
      "description": "N expressions jointly pinned to a breakpoint-indexed piecewise curve.\n\nMirrors ``linopy.Spec.add_piecewise_formulation``. Each link is\n``[expression, values_parameter]`` or ``[expression, values_parameter,\nsign]``: *expression* is any affine expression string, *values_parameter*\nnames a parameter carrying the ``over`` dim, and *sign* bounds the link by\nthe curve instead of pinning it (at most one non-``\"==\"``, and only with\nexactly two links).",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/PiecewiseLink"
          },
          "title": "Links",
          "type": "array"
        },
        "method": {
          "default": "adjacency",
          "enum": [
            "adjacency",
            "sos2",
            "convex",
            "lp"
          ],
          "title": "Method",
          "type": "string"
        },
        "over": {
          "title": "Over",
          "type": "string"
        },
        "points": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Points"
        }
      },
      "required": [
        "over",
        "links"
      ],
      "title": "PiecewiseBlock",
      "type": "object"
    },
    "PiecewiseLink": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "One link of a piecewise block: an expression pinned to a values curve.\n\nWritten in YAML as ``[expression, values]`` or ``[expression, values,\nsign]`` and serialised back to exactly that form, so a round trip through\n:meth:`Spec.to_yaml` reproduces the file.",
          "properties": {
            "expression": {
              "title": "Expression",
              "type": "string"
            },
            "sign": {
              "default": "==",
              "enum": [
                "<=",
                ">=",
                "=="
              ],
              "title": "Sign",
              "type": "string"
            },
            "values": {
              "title": "Values",
              "type": "string"
            }
          },
          "required": [
            "expression",
            "values"
          ],
          "title": "PiecewiseLink",
          "type": "object"
        },
        {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 2,
          "type": "array"
        }
      ]
    },
    "SosBlock": {
      "additionalProperties": false,
      "description": "A special-ordered set over one dimension of one variable.\n\nOne set per coordinate of the variable's ``foreach`` minus ``over``; the\nmembers are the variable's *existing* coordinates along ``over``, in that\ndimension's declared order, and ``big_m`` is the optional cap a consumer\nthat reformulates the set puts on its linking rows.\n\n``type: 1`` admits at most one nonzero member, ``type: 2`` at most two,\nand those two consecutive. Unlike every other block this one declares no\nmath to read off ``A``: it is a *set*, carried to a consumer that has the\nconcept and reformulated for one that does not.",
      "properties": {
        "big_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Big M"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "over": {
          "title": "Over",
          "type": "string"
        },
        "type": {
          "enum": [
            1,
            2
          ],
          "title": "Type",
          "type": "integer"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "variable",
        "over",
        "type"
      ],
      "title": "SosBlock",
      "type": "object"
    },
    "VariableBlock": {
      "additionalProperties": false,
      "description": "A declared decision variable.",
      "properties": {
        "absence": {
          "default": "undefined",
          "enum": [
            "undefined",
            "zero"
          ],
          "title": "Absence",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/BoundsBlock",
          "default": {}
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "domain": {
          "default": "continuous",
          "enum": [
            "continuous",
            "integer",
            "binary"
          ],
          "title": "Domain",
          "type": "string"
        },
        "foreach": {
          "items": {
            "type": "string"
          },
          "title": "Foreach",
          "type": "array"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        }
      },
      "required": [
        "foreach"
      ],
      "title": "VariableBlock",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The declared math \u2014 one YAML file, or one dict, validated. Nothing here has seen data.\n\nA ``Spec`` that exists has passed the whole language: constructing one by\nany route \u2014 ``to_spec``, :meth:`model_validate`, the constructor \u2014 runs\nevery load-time check, expansion and expression pass included, and raises\n:class:`~math_spec.errors.LanguageError` on a model the language refuses.\nHolding one is the proof, so nothing downstream checks it again.\n\nThe API is the ten declaration sections plus ``version`` and\n``description``, and two ways back out: :meth:`to_dict` for the model as\ndata, :meth:`to_yaml` for the file a reviewer reads. Everything else on\nthis class is pydantic's, not a contract this package keeps.",
  "properties": {
    "constraints": {
      "additionalProperties": {
        "$ref": "#/$defs/ConstraintBlock"
      },
      "default": {},
      "title": "Constraints",
      "type": "object"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "dimensions": {
      "additionalProperties": {
        "$ref": "#/$defs/DimensionBlock"
      },
      "default": {},
      "title": "Dimensions",
      "type": "object"
    },
    "expressions": {
      "additionalProperties": {
        "$ref": "#/$defs/ExpressionBlock"
      },
      "default": {},
      "title": "Expressions",
      "type": "object"
    },
    "lookups": {
      "additionalProperties": {
        "$ref": "#/$defs/LookupBlock"
      },
      "default": {},
      "title": "Lookups",
      "type": "object"
    },
    "macros": {
      "additionalProperties": {
        "$ref": "#/$defs/MacroBlock"
      },
      "default": {},
      "title": "Macros",
      "type": "object"
    },
    "objective": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectiveBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/ParameterBlock"
      },
      "default": {},
      "title": "Parameters",
      "type": "object"
    },
    "piecewise": {
      "additionalProperties": {
        "$ref": "#/$defs/PiecewiseBlock"
      },
      "default": {},
      "title": "Piecewise",
      "type": "object"
    },
    "sos": {
      "additionalProperties": {
        "$ref": "#/$defs/SosBlock"
